# OS
.DS_Store
Thumbs.db

# Scripts: 代码脚本纳入版本控制，内部文档/缓存忽略
scripts/*.md
scripts/__pycache__/
*.md
# Python 缓存
__pycache__/
*.pyc
# 但 tools/ 下的交付物（GEO清单/发布门禁/选题日历等）需纳入版本控制
!tools/*.md
# CM-2026 真源（立项书/决策台账/能力模型/校验清单等）必须纳入版本控制，
# 否则「projects/ 已落 commit」是假成功：目录可见而真源 .md 全不在库里（D-034）
!projects/**/*.md

# Google API credentials (DO NOT COMMIT)
gsc_service_account.json

# GitHub PAT / secrets (DO NOT COMMIT — push protection blocks them)
.github_token
scripts/.github_token
.env
scripts/.env
*.env

# Cloudflare Workers local dev secrets (DO NOT COMMIT — use `wrangler secret put` for prod)
.dev.vars

# Deploy package
*.tar.gz

# 临时备份目录
assets/images/banners/_backup/
